{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure Debug",
      "type": "shell",
      "command": "cmake -S . -B build-mac -DCMAKE_BUILD_TYPE=Debug -DCMAKE_PREFIX_PATH=\"$(brew --prefix)\" -DCMAKE_OSX_DEPLOYMENT_TARGET=\"$(sw_vers -productVersion | cut -d. -f1,2)\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: build Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build-mac",
        "--parallel",
        "2"
      ],
      "dependsOn": "CMake: configure Debug",
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
